{
  "name": "readnote",
  "displayName": "ReadNote",
  "version": "1.0.0",
  "description": "ReadNote - A Chrome extension for AI-powered reading, notes, and highlights",
  "private": true,
  "scripts": {
    "dev": "plasmo dev --src-path=. --target=chrome-mv3",
    "build": "plasmo build --src-path=. --target=chrome-mv3",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "package": "plasmo package --src-path=. --target=chrome-mv3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "plasmo": "^0.90.5",
    "ts-jest": "^29.4.15",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chrome-extension",
    "ai",
    "reading",
    "notes",
    "highlights",
    "text-to-speech"
  ],
  "license": "MIT",
  "manifest": {
    "permissions": [
      "activeTab",
      "tabs",
      "storage",
      "contextMenus",
      "sidePanel",
      "identity",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/icons/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "action": {
      "default_popup": "../src/popup/popup.html",
      "default_title": "ReadNote"
    },
    "side_panel": {
      "default_path": "../src/sidepanel/sidepanel.html"
    }
  }
}
